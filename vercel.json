{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd decentraland_letterush-master && npm install",
  "buildCommand": "cd decentraland_letterush-master && npm run build:vercel",
  "outputDirectory": "decentraland_letterush-master/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "*" }
      ]
    }
  ]
}
